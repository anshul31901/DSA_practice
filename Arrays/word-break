https://leetcode.com/problems/word-break/
class Solution {
public:
    bool wordBreak(string s, vector<string>& wordDict) {
        int n = s.size();

        //dp[i]= if this substring from length 1 to i can be made from words form dictionary

        //dp[0] = 1
        //dp[4] = map(subsrung) and DP[0];
        //dp[8] = 




        unordered_set<string>words(wordDict.begin(), wordDict.end());
        vector<bool>dp(n+1,false);
        dp[0]= true;//empty string can be made by taking nothing
        int maxLen = 0;
        for(auto w : wordDict){
            maxLen = max(maxLen, (int)w.size());
        }
        //dp[i] = true if we find a j such that j <i , dp[j]=1 and j+1 to i the word exists in dictionary 
        for(int i = 1; i <=n ; i++){
            for(int j = max(0,i-maxLen); j<i; j++){
                if(dp[j]==1 && words.count(s.substr(j,i-j)) ){
                    dp[i]=1;
                    break;
                }
                
            }


        }
        return dp[n];
    }
};
